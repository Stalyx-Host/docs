{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Stalyx",
  "colors": {
    "primary": "#1f4e8c",
    "light": "#386cb0",
    "dark": "#0a2e5c"
  },
  "favicon": {
    "light": "/images/Artboard5White.png",
    "dark": "/images/Artboard5White.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/Black.png",
    "dark": "/images/White.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@stalyx.xyz"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/@stalyxhost",
      "discord": "https://discord.gg/stalyx"
    }
  },
  "errors": {
    "404": {
      "redirect": false
    }
  }
}
