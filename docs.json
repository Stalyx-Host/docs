{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Stalyx",
  "colors": {
    "primary": "#2f7ce1",
    "light": "#2f7ce1",
    "dark": "#0a2e5c"
  },
  "favicon": {
    "light": "/images/Artboard5White.png",
    "dark": "/images/Artboard5White.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Home",
        "icon": "globe",
        "groups": [
          {
            "group": "Base Information",
            "pages": [
              "home"
            ]
          }
        ]
      },
      {
        "tab": "Knowledge Base",
        "icon": "book-open-alt",
        "dropdowns": [
          {
            "dropdown": "Accounts",
            "icon": "user",
            "groups": [
              {
                "group": "Billing Panel",
                "icon": "arrow-right",
                "pages": [
                  {
                    "group": "Basics",
                    "expanded": true,
                    "pages": [
                      "articles/accounts/billing/soon"
                    ]
                  }
                ]
              },
              {
                "group": "Server Panel",
                "icon": "arrow-right",
                "pages": [
                  {
                    "group": "Basics",
                    "expanded": true,
                    "pages": [
                      "articles/accounts/main/soon"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "dropdown": "Servers",
            "icon": "server",
            "groups": [
              {
                "group": "Discord",
                "expanded": true,
                "pages": [
                  {
                    "group": "Info",
                    "expanded": true,
                    "pages": [
                      "articles/servers/discord/info/soon"
                    ]
                  },
                  {
                    "group": "Features",
                    "pages": []
                  }
                ],
                "icon": "arrow-right"
              }
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "icon": "newspaper",
        "menu": [
          {
            "item": "Status",
            "icon": "satellite-dish",
            "description": "Access our server status.",
            "href": "https://status.stalyx.xyz"
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/Black.png",
    "dark": "/images/White.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@stalyx.xyz"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Server Panel",
      "href": "https://panel.stalyx.xyz"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/@stalyxhost",
      "discord": "https://discord.gg/stalyx",
      "website": "https://stalyx.xyz"
    },
    "links": [
      {
        "header": "Important",
        "items": [
          {
            "label": "Billing Site",
            "href": "https://billing.stalyx.xyz"
          },
          {
            "label": "Panel Site",
            "href": "https://panel.stalyx.xyz"
          },
          {
            "label": "Status",
            "href": "https://status.stalyx.xyz"
          }
        ]
      },
      {
        "header": "Main Pages",
        "items": [
          {
            "label": "Discord Bot Hosting",
            "href": "/"
          }
        ]
      }
    ]
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "decoration": "gradient"
  }
}
